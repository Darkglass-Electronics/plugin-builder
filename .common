#!/bin/bash

#######################################################################################################################
# exit if any command fails

set -e

#######################################################################################################################
# environment variables

WORKDIR=${WORKDIR:=~/darkglass-linux-workdir}

#######################################################################################################################
# Colored print functions

function error {
  echo -e "\e[0;31m"$@"\e[0m"
  exit 1
}

function info {
  echo -e "\e[0;32m"$@"\e[0m"
}

function warn {
  echo -e "\e[0;33m"$@"\e[0m"
}

#######################################################################################################################
# check for old installation

if [ -z "${PLATFORM}" ]; then
  error "Incorrect use of .common, PLATFORM not defined!"
fi

#######################################################################################################################
# check for custom and debug builds

if [[ "${PLATFORM}" == *"-debug" ]]; then
  TOOLCHAIN_PLATFORM="$(echo ${PLATFORM} | sed 's/-debug//')"
else
  TOOLCHAIN_PLATFORM="${PLATFORM}"
fi

if [[ "${PLATFORM}" = "darkglass-anagram-gcc15"* ]]; then
  TOOLCHAIN_PLATFORM="darkglass-cortex-a76.a55-gcc15"
  BR2_PLATFORM="${PLATFORM}"
elif [[ "${PLATFORM}" = "darkglass-anagram"* ]]; then
  TOOLCHAIN_PLATFORM="darkglass-cortex-a76.a55-gcc9"
  BR2_PLATFORM="${PLATFORM}"
else
  BR2_PLATFORM="${TOOLCHAIN_PLATFORM}"
fi

#######################################################################################################################
# define buildroot and toolchain version per platform

case "${TOOLCHAIN_PLATFORM}" in
  # GCC 15 target: ct-ng 1.28 with glibc 2.34
  "darkglass-cortex-a76.a55-gcc15")
    BUILDROOT_VERSION=buildroot-2023.11.3
    CT_NG_VERSION=crosstool-ng-1.28.0
  ;;
  # GCC 9 target: ct-ng 1.25 with glibc 2.34
  "darkglass-cortex-a76.a55-gcc9")
    BUILDROOT_VERSION=buildroot-2023.11.3
    CT_NG_VERSION=crosstool-ng-1.25.0
  ;;
  # fallback
  *)
    error "Unknown platform"
  ;;
esac

#######################################################################################################################
# crosstool-ng variables

CT_NG_LINK=http://crosstool-ng.org/download/crosstool-ng/
CT_NG_FILE=${CT_NG_VERSION}.tar.bz2

#######################################################################################################################
# buildroot variables

BUILDROOT_LINK=https://buildroot.org/downloads/
BUILDROOT_FILE=${BUILDROOT_VERSION}.tar.xz

SOURCE_DIR="$(pwd)"
BR2_EXTERNAL=${SOURCE_DIR}/plugins-dep
BR2_MAKE="make O=${WORKDIR}/${PLATFORM} BR2_EXTERNAL=${BR2_EXTERNAL} BR2_PLATFORM=${BR2_PLATFORM}"
BR2_TARGET=${WORKDIR}/${PLATFORM}/target

#######################################################################################################################
# setup directories

BUILD_DIR=${WORKDIR}/${PLATFORM}/build
DOWNLOAD_DIR=${WORKDIR}/download
TOOLCHAIN_DIR=${WORKDIR}/${TOOLCHAIN_PLATFORM}/toolchain
TOOLCHAIN_BUILD_DIR=${WORKDIR}/${TOOLCHAIN_PLATFORM}/build

mkdir -p ${BUILD_DIR}
mkdir -p ${DOWNLOAD_DIR}
mkdir -p ${TOOLCHAIN_DIR}

#######################################################################################################################
